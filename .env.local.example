# Copy to .env.local and fill in what you have. Every key is optional:
# with none set, the globe uses keyless Esri imagery and keyless feeds.

# Imagery chain: Cesium ion -> Google Photorealistic 3D Tiles -> Esri (keyless).
# NEXT_PUBLIC_* values are shipped to the browser; restrict them by HTTP referrer.
NEXT_PUBLIC_CESIUM_ION_TOKEN=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=

# Server-only. NASA FIRMS MAP_KEY; the Fires layer is disabled without it.
FIRMS_MAP_KEY=

# Server-only. OpenSky OAuth2 client credentials (4000 credits/day vs 400 anonymous).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
